<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Wi-Fi / TCP -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service: чтобы Android не убил процесс при сворачивании
         приложения с активным BT/Wi-Fi соединением. CONNECTED_DEVICE — тип
         сервиса, обязателен на API 34+ для работы с BT/USB-периферией. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- POST_NOTIFICATIONS — Android 13+ для показа foreground-уведомления.
         Без неё сервис всё равно работает, но иконки в шторке не видно. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bluetooth: legacy. Без maxSdkVersion намеренно: на стоковом Android 12+
         хватает BLUETOOTH_CONNECT, но MIUI/HyperOS (и ряд других OEM) дополнительно
         энфорсят легаси android.permission.BLUETOOTH при RFCOMM-connect() и кидают
         SecurityException "lacks permission android.permission.BLUETOOTH". Это
         normal-пермишены (авто-грант на установке), на 31+ безвредны. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- Bluetooth runtime (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Location: required for BT scan on API < 31. На API 31+ не запрашиваем благодаря
         neverForLocation. COARSE рядом с FINE — требование lint (CoarseFineLocation). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <!-- USB host: для подключения OTG-кабелем к плате через UART-bridge
         (CP210x, CDC, FTDI, CH34x, Prolific). required=false — приложение
         работает и без USB-хоста (есть BT и Wi-Fi). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".ConnectApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConnectApp">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.wifi.WifiActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.bluetooth.BluetoothActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- GraphActivity открывается из BluetoothActivity, UsbSerialActivity
             или TestActivity. parentActivityName зашит на BluetoothActivity
             заставлял system Up-стрелку всегда вести в BT-экран независимо
             от источника. Без parentActivityName Up-навигация делегируется
             onBackPressed() / finish() — возврат к Activity, которая нас
             открыла. -->
        <activity
            android:name=".ui.graph.GraphActivity"
            android:exported="false" />

        <activity
            android:name=".ui.test.TestActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.usb.UsbSerialActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.mqtt.MqttSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.anomaly.AnomalyLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.graph.GraphActivity" />

        <activity
            android:name=".ui.console.CommandLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.bluetooth.BluetoothActivity" />

        <activity
            android:name=".ui.rrd.RrdEventLogActivity"
            android:exported="false"
            android:parentActivityName=".ui.graph.GraphActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Foreground service для долгих BT/Wi-Fi сессий — держит процесс
             живым при сворачивании приложения. Тип connectedDevice требуется
             на Android 14+. -->
        <service
            android:name=".service.ConnectionForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
